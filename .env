
# ---------- Compose project & network ----------
COMPOSE_PROJECT_NAME=dbanking-op2

# ---------- Postgres ----------
POSTGRES_DB=dBanking_profileMgt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5434          # host -> container:5434

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123
RABBITMQ_AMQP_PORT=5674     # host -> container:5672
RABBITMQ_HTTP_PORT=15674    # host -> container:15672

# ---------- API ----------
API_HTTP_PORT=9091
ASPNETCORE_ENVIRONMENT=Development

# Container/user
APP_UID=1000

# Optional: detailed error for Postgres (handy in dev)
PG_INCLUDE_ERROR_DETAIL=true